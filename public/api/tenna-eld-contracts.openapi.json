    "/eld/v1/assets": {
      "get": {
        "tags": [
          "T4 Assets"
        ],
        "summary": "Find assets by tracker serial, ELD flag or id list",
        "description": "tracker_serial: one asset, at pairing. eld=true: the pairing list, every ELD-enabled asset. ids: batch, up to 200; keeps resolving an asset after its tracker is removed or the asset is retired. Always returns an array.",
        "operationId": "get_assets",
        "parameters": [
          {
            "name": "tracker_serial",
            "in": "query",
            "description": "Tracker serial from the BLE scan.",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "WQ-87X060680218"
          },
          {
            "name": "eld",
            "in": "query",
            "description": "Only assets whose tracker is an ELD model.",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "example": true
          },
          {
            "name": "ids",
            "in": "query",
            "description": "Comma-separated asset ids, up to 200.",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "ast_2181"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Asset"
                  }
                },
                "examples": {
                  "by_tracker_serial_pairing": {
                    "summary": "By tracker serial (pairing)",
                    "value": [
