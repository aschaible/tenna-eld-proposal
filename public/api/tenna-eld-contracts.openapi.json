  "components": {
    "securitySchemes": {
      "cognitoJwt": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Cognito access token from the pool every Tenna app uses. Claims: see TokenClaims."
      }
    },
    "schemas": {
      "TokenClaims": {
        "type": "object",
        "description": "T1 Identity. Not an endpoint: the claims the ELD relies on in the Cognito JWT that every call sends. Session 30 days with hourly refresh; the ELD prompts re-sign-in at day 25.",
        "required": [
          "sub",
          "username",
          "account_id",
          "roles",
          "licenses",
          "exp",
          "iat"
        ],
        "properties": {
          "sub": {
            "type": "string",
            "description": "Tenna user id. Stored as driver_id on every ELD event."
          },
          "username": {
            "type": "string",
            "description": "ELD username (Appendix A 7.18): the sign-in name. An email address is acceptable. Never issued to a second person in the same account.",
            "minLength": 4,
            "maxLength": 60
          },
          "account_id": {
            "type": "string",
            "description": "The carrier. Every ELD row is scoped to it."
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Driver, supervisor, mechanic."
          },
          "licenses": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Must include \"eld\", or the T8 entitlement flag is used instead."
          },
          "exp": {
            "type": "integer",
            "description": "Expiry, epoch seconds."
          },
          "iat": {
            "type": "integer",
            "description": "Issued at, epoch seconds."
          },
          "acting_as": {
            "type": "string",
            "description": "OPEN. Present only when Tenna staff are viewing as a customer user. The ELD treats the session as read-only (4.1.2).",
            "nullable": true
          }
        },
        "example": {
          "sub": "usr_8f21c4",
          "username": "malvarez",
          "account_id": "acc_0413",
          "roles": [
            "driver"
          ],
          "licenses": [
            "eld"
          ],
          "iat": 1758067200,
          "exp": 1760659200
        }
      },
      "Person": {
        "type": "object",
        "required": [
          "id",
          "username",
          "first_name",
          "last_name",
          "is_driver",
          "status",
          "roles"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Join key to every ELD row."
          },
          "username": {
            "type": "string",
            "description": "ELD username (7.18), same value as the token claim.",
            "minLength": 4,
            "maxLength": 60
          },
          "first_name": {
            "type": "string",
            "description": "First name (7.28). Required for everyone: the output file user list names each supervisor who requested an edit."
          },
          "last_name": {
            "type": "string",
            "description": "Last name (7.30)."
          },
          "is_driver": {
            "type": "boolean",
            "description": "Who appears in the roster and may hold duty status. Sets ELD account type (7.13): D or S."
          },
          "status": {
            "type": "string",
            "description": "Rosters and pickers hide inactive people; past records still show their name.",
            "enum": [
              "active",
              "inactive"
            ]
          },
          "exempt": {
            "type": "boolean",
            "description": "Exempt driver per 4.3.3.1.2. Null means false.",
            "nullable": true
          },
          "exempt_annotation": {
            "type": "string",
            "description": "Reason recorded with the exemption. Required when exempt is true.",
            "nullable": true
          },
          "cdl": {
            "type": "object",
            "description": "Required for drivers. Returned only to callers with eld.logs.read.",
            "required": [
              "number",
              "state"
            ],
            "properties": {
              "number": {
                "type": "string",
                "description": "Driver's license number (7.11)."
              },
              "state": {
                "type": "string",
                "description": "Driver's license issuing state (7.10).",
                "minLength": 2,
                "maxLength": 2
              }
            },
            "nullable": true
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Same vocabulary as the token."
          },
          "email": {
            "type": "string",
            "description": "Contact line on D23; needed if own-records delivery goes by email.",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "description": "Contact line only.",
            "nullable": true
          }
        }
      },
      "Account": {
        "type": "object",
        "required": [
          "id",
          "name",
          "usdot",
          "address"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stored as carrier_id on every ELD row."
          },
          "name": {
            "type": "string",
            "description": "Carrier name (7.2)."
          },
          "usdot": {
            "type": "string",
            "description": "Carrier's USDOT number (7.3).",
            "pattern": "^[0-9]{1,9}$"
          },
          "address": {
            "type": "object",
            "required": [
              "street",
              "city",
              "state",
              "zip"
            ],
            "description": "Carrier address on the roadside display and printed logs.",
            "properties": {
              "street": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "minLength": 2,
                "maxLength": 2
              },
              "zip": {
                "type": "string"
              }
            }
          },
          "support_contact": {
            "type": "object",
            "description": "Who a driver calls at the carrier about the ELD (D25). Null hides the line.",
            "properties": {
              "name": {
                "type": "string",
                "nullable": true
              },
              "phone": {
                "type": "string",
                "nullable": true
              },
              "email": {
                "type": "string",
                "nullable": true
              }
            },
            "nullable": true
          }
        }
      },
      "Asset": {
        "type": "object",
        "required": [
          "id",
          "name",
          "vin",
          "tracker"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stored as asset_id on every event and link."
          },
          "name": {
            "type": "string",
            "description": "Fleet unit number; the CMV power unit number (7.4)."
          },
          "vin": {
            "type": "string",
            "description": "CMV VIN of record (7.5). Cross-checked against the VIN the tracker reads.",
            "minLength": 17,
            "maxLength": 17
          },
          "category": {
            "type": "string",
            "description": "Display only. Categories are per-account; the ELD never branches on it.",
            "nullable": true
          },
          "assigned_driver_id": {
            "type": "string",
            "description": "Tenna's driver-to-vehicle assignment, shown on W1. Display only.",
            "nullable": true
          },
          "tracker": {
            "type": "object",
            "required": [
              "serial",
              "model"
            ],
            "description": "Null once the tracker is removed; the asset still resolves by id.",
            "properties": {
              "serial": {
                "type": "string",
                "description": "The join from a BLE scan to an asset."
              },
              "model": {
                "type": "string",
                "description": "ELD-enabled means this is one of Tenna's two ELD tracker models."
              },
              "firmware_version": {
                "type": "string",
                "description": "Null means unknown.",
                "nullable": true
              }
            },
            "nullable": true
          },
          "trailer_number": {
            "type": "string",
            "description": "Trailer number (7.42) if Tenna keeps it on the asset or DVIR record; otherwise the driver enters it on D2.",
            "nullable": true
          }
        }
      },
      "TrackerModel": {
        "type": "object",
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "A tracker model name that marks an asset as ELD-enabled."
          }
        }
      },
      "Site": {
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "geometry",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Cache key."
          },
          "name": {
            "type": "string",
            "description": "Shown on D9 when a yard move ends."
          },
          "type": {
            "type": "string",
            "description": "Only \"yard\" is read. Tenna names the site type that means a yard."
          },
          "geometry": {
            "type": "object",
            "description": "GeoJSON Polygon. A circle is accepted as centre plus radius if that is how Tenna stores it.",
            "required": [
              "type",
              "coordinates"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "Polygon"
                ]
              },
              "coordinates": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          },
          "updated_at": {
            "type": "string",
            "description": "Refresh only what changed.",
            "format": "date-time"
          }
        }
      },
      "WorkOrder": {
        "type": "object",
        "required": [
          "id",
          "number",
          "asset_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stored on the road test annotation."
          },
          "number": {
            "type": "string",
            "description": "Human reference shown on D27."
          },
          "job_number": {
            "type": "string",
            "description": "Job or project the work is under. Pre-fills the shipping document field (7.39) on D2.",
            "nullable": true
          },
          "asset_id": {
            "type": "string",
            "description": "Must match the paired asset."
          },
          "summary": {
            "type": "string",
            "description": "Picker line.",
            "nullable": true
          },
          "assigned_to": {
            "type": "string",
            "description": "User id. Sorts the mechanic's own orders first.",
            "nullable": true
          }
        }
      },
      "DvirStatus": {
        "type": "object",
        "required": [
          "status",
          "defects_open"
        ],
        "description": "Contract still to be written with Tenna; these are the fields D14 needs.",
        "properties": {
          "status": {
            "type": "string",
            "description": "Which of the three states D14 draws.",
            "enum": [
              "not_started",
              "started",
              "submitted"
            ]
          },
          "inspection_id": {
            "type": "string",
            "description": "Present when started or submitted.",
            "nullable": true
          },
          "submitted_at": {
            "type": "string",
            "description": "Present when submitted.",
            "format": "date-time",
            "nullable": true
          },
          "defects_open": {
            "type": "integer",
            "description": "Warns the driver before they drive; the ELD does not block."
          },
          "shipping_document_number": {
            "type": "string",
            "description": "Shipping document number (7.39) if Tenna's DVIR flow includes it.",
            "nullable": true
          }
        }
      },
      "Entitlements": {
        "type": "object",
        "required": [
          "account_id",
          "modules",
          "permissions"
        ],
        "properties": {
          "account_id": {
            "type": "string",
            "description": "Must match the token."
          },
          "modules": {
            "type": "object",
            "required": [
              "eld"
            ],
            "properties": {
              "eld": {
                "type": "boolean",
                "description": "Sign-in gate."
              }
            }
          },
          "permissions": {
            "type": "array",
            "description": "Each W screen checks one.",
            "items": {
              "type": "string",
              "enum": [
                "eld.logs.read",
                "eld.logs.propose_edit",
                "eld.settings.write",
                "eld.ud.assign",
                "eld.transfer.request"
              ]
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
